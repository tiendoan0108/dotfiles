// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // AI
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "split",

  "edit_predictions": {
    "mode": "eager",
    "provider": "none",
  },

  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry",
    },
    "opencode": {
      "favorite_config_option_values": {
        "effort": ["medium"],
      },
      "type": "registry",
      "default_mode": "plan",
    },
  },
  "disable_ai": false,
  "show_edit_predictions": false,

  // Agent AI Setup
  "agent": {
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.4",
    },
    "favorite_models": [],
    "model_parameters": [],
  },

  "on_new_window": "launchpad",

  // SSH setup
  "ssh_connections": [],

  // UI Configuration
  "git_panel": {
    "tree_view": false,
  },

  "project_panel": {
    "indent_size": 14,
    "entry_spacing": "standard",
  },

  "icon_theme": "Material Icon Theme",
  "theme": "Catppuccin Frappé - No Italics",

  "tabs": {
    "git_status": true,
    "show_diagnostics": "errors",
    "file_icons": true,
    "show_close_button": "always",
  },

  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },

  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },

  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },

  "ui_font_size": 15,
  "ui_font_family": "ZedMono Nerd Font",

  // Buffer config
  "buffer_font_size": 14,
  "buffer_font_family": "ZedMono Nerd Font",
  "buffer_line_height": {
    "custom": 1.4
  },

  // Terminal
  "terminal": {
    "font_size": 12,
    "line_height": "standard",
    "font_weight": 300,
  },

  "cursor_blink": false,

  "minimap": {
    "show": "auto"
  },

  // Vim
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "highlight_on_yank_duration": 200,
    "use_smartcase_find": true,
    "use_regex_search": true,
    "gdefault": true
  },

  // Prettier format
  "formatter": "auto",
  "format_on_save": "off",
  "prettier": {
    "allowed": true,
  },
}
