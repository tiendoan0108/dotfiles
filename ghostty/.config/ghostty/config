# Font
font-family = "JetBrainsMono NF SemiBold"
adjust-cell-height = 12%
font-size = 13
freetype-load-flags = hinting,autohint,light

# Background
window-padding-x = 8
background-blur = true

# Theme
theme = Catppuccin Macchiato
command = zsh

macos-option-as-alt = true
macos-window-shadow = false
